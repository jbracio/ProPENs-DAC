@code {
    public static Statistiken? Instance;

    @inject IJSRuntime JSRuntime
    private List<IWHEntry> allEntries = new();
    private List<IWHEntry> entries = new();
    private List<TotalScoreEntry> totalScoreEntries = new();

    // Sorting state
    private string sortColumn = "";
    private bool sortDescending = false;

    protected override async Task OnInitializedAsync()
    {
        Instance = this;
        // Load IWH data
        using var stream = await Http.GetStreamAsync("data/IWH_data.csv");
        using var reader = new StreamReader(stream);
        var config = new CsvConfiguration(CultureInfo.InvariantCulture)
        {
            Delimiter = ";",
            HeaderValidated = null,
            MissingFieldFound = null
        };
        using var csv = new CsvReader(reader, config);
        csv.Context.RegisterClassMap<IWHEntryMap>();
        allEntries = csv.GetRecords<IWHEntry>().ToList();
        foreach (var entry in allEntries)
        {
            entry.IsVisible = true;
        }
        entries = allEntries.Where(e => e.IsVisible).ToList();

        // Load TotalScore data
        using var totalScoreStream = await Http.GetStreamAsync("data/totalscore.csv");
        using var totalScoreReader = new StreamReader(totalScoreStream);
        var totalScoreConfig = new CsvConfiguration(CultureInfo.InvariantCulture)
        {
            Delimiter = ";",
            HeaderValidated = null,
            MissingFieldFound = null
        };
        using var totalScoreCsv = new CsvReader(totalScoreReader, totalScoreConfig);
        totalScoreCsv.Context.RegisterClassMap<TotalScoreEntryMap>();
        totalScoreEntries = totalScoreCsv.GetRecords<TotalScoreEntry>().ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("loadTotalScoreMap");
            await JS.InvokeVoidAsync("loadElectricityMap");
            await JS.InvokeVoidAsync("loadLandUseMap");
            await JS.InvokeVoidAsync("loadTransportMap");
            await JS.InvokeVoidAsync("loadResMap");
            await JS.InvokeVoidAsync("loadIwhMap");

        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            sortColumn = column;
            sortDescending = true;
        }
        ApplySortInternal();
    }

    // New method to support forcing ascending sort, e.g. for County column
    private void ApplySort(string column, bool ascending = false)
    {
        if (sortColumn != column)
        {
            sortColumn = column;
            sortDescending = !ascending ? true : false;
        }
        else
        {
            // If clicking same column, toggle as usual
            sortDescending = !sortDescending;
        }
        ApplySortInternal();
    }

    private void ApplySortInternal()
    {
        entries = sortColumn switch
        {
            nameof(IWHEntry.County) => (sortDescending ? entries.OrderByDescending(e => e.County) : entries.OrderBy(e => e.County)).ToList(),
            "DirectConnections" => (sortDescending ? entries.OrderByDescending(e => e.DirectConnections) : entries.OrderBy(e => e.DirectConnections)).ToList(),
            "TotalWasteHeat" => (sortDescending ? entries.OrderByDescending(e => e.TotalWasteHeat) : entries.OrderBy(e => e.TotalWasteHeat)).ToList(),
            "NumberOfSources" => (sortDescending ? entries.OrderByDescending(e => e.NumberOfSources) : entries.OrderBy(e => e.NumberOfSources)).ToList(),
            "WeightedScore" => (sortDescending ? entries.OrderByDescending(e => e.WeightedScore) : entries.OrderBy(e => e.WeightedScore)).ToList(),
            "BestScore" => (sortDescending ? entries.OrderByDescending(e => e.BestScore) : entries.OrderBy(e => e.BestScore)).ToList(),
            "AmountWasteHeatBestScore" => (sortDescending ? entries.OrderByDescending(e => e.AmountWasteHeatBestScore) : entries.OrderBy(e => e.AmountWasteHeatBestScore)).ToList(),
            _ => entries
        };
    }

    private MarkupString GetSortIcon(string column)
    {
        if (sortColumn != column) return new MarkupString("");
        return sortDescending
            ? new MarkupString("&#9660;") // ▼
            : new MarkupString("&#9650;"); // ▲
    }

    private double weightedScoreThreshold = 0;
    private double bestScoreThreshold = 0;
    private double directConnectionsThreshold = 0;
    private int totalWasteHeatThreshold = 0;

    private async Task ApplyFilters()
    {
        var filteredCountyNames = await JS.InvokeAsync<string[]>(
            "setThresholdsAndApplyFilters",
            weightedScoreThreshold,
            bestScoreThreshold,
            directConnectionsThreshold,
            totalWasteHeatThreshold);

        foreach (var entry in allEntries)
        {
            entry.IsVisible = filteredCountyNames.Contains(entry.County, StringComparer.OrdinalIgnoreCase);
        }

        entries = allEntries
            .Where(e => e.IsVisible)
            .ToList();

        StateHasChanged();
    }
    private async Task ResetAllFilters()
    {
        weightedScoreThreshold = 0;
        bestScoreThreshold = 0;
        directConnectionsThreshold = 0;
        totalWasteHeatThreshold = 0;

        // Reset the slider values and labels via JS
        await JS.InvokeVoidAsync("resetSliderValues");

        // Setze die Schwellenwerte in JS und aktualisiere Filter (inkl. Karte)
        var filteredCountyNames = await JS.InvokeAsync<string[]>(
            "setThresholdsAndApplyFilters",
            0, 0, 0, 0);

        foreach (var entry in allEntries)
        {
            entry.IsVisible = filteredCountyNames.Contains(entry.County, StringComparer.OrdinalIgnoreCase);
        }

        entries = allEntries
            .Where(e => e.IsVisible)
            .ToList();

        StateHasChanged();
    }
    // --- Total Score Table Sorting State and Methods ---
    private string totalScoreSortColumn = "";
    private bool totalScoreSortDescending = false;

    private void SortTotalScoreBy(string column)
    {
        if (totalScoreSortColumn == column)
        {
            totalScoreSortDescending = !totalScoreSortDescending;
        }
        else
        {
            totalScoreSortColumn = column;
            totalScoreSortDescending = true;
        }

        // Sortiere nur totalScoreEntries
        totalScoreEntries = totalScoreSortColumn switch
        {
            nameof(TotalScoreEntry.County) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.County) : totalScoreEntries.OrderBy(e => e.County)).ToList(),
            nameof(TotalScoreEntry.TotalScore) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.TotalScore) : totalScoreEntries.OrderBy(e => e.TotalScore)).ToList(),
            nameof(TotalScoreEntry.WasteHeatScore) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.WasteHeatScore) : totalScoreEntries.OrderBy(e => e.WasteHeatScore)).ToList(),
            nameof(TotalScoreEntry.ElectricityScore) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.ElectricityScore) : totalScoreEntries.OrderBy(e => e.ElectricityScore)).ToList(),
            nameof(TotalScoreEntry.RenewableScore) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.RenewableScore) : totalScoreEntries.OrderBy(e => e.RenewableScore)).ToList(),
            nameof(TotalScoreEntry.CO2TransportScore) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.CO2TransportScore) : totalScoreEntries.OrderBy(e => e.CO2TransportScore)).ToList(),
            nameof(TotalScoreEntry.LandUsageScore) => (totalScoreSortDescending ? totalScoreEntries.OrderByDescending(e => e.LandUsageScore) : totalScoreEntries.OrderBy(e => e.LandUsageScore)).ToList(),
            _ => totalScoreEntries
        };
    }

    private MarkupString GetTotalScoreSortIcon(string column)
    {
        if (totalScoreSortColumn != column) return new MarkupString("");
        return totalScoreSortDescending
            ? new MarkupString("&#9660;")
            : new MarkupString("&#9650;");
    }
}

