@page "/about"

<div style="
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('img/background.jpg') no-repeat center center fixed;
    background-size: cover;
    opacity: 0.4;
    z-index: -1;">
</div>

<PageTitle>About the Project</PageTitle>


<!-- DAC EXPLANATION AND USE CASES -->
<section style="padding: 50px 20px 30px; margin-bottom: 40px; max-width: 96%; background-color: #ffffff; border-radius: 12px;">
    <h2 style="font-size: 1.8rem; font-weight: 600; margin-bottom: 30px; color: #003C78; text-align: center;">About the Project</h2>
     
    <div style="display: flex; flex-wrap: wrap; gap: 30px; align-items: flex-start;">
        <!-- Linke Spalte: Erklärungstext -->
        <div style="flex: 1 1 300px;">
            <p style="font-size: 1.05rem; line-height: 1.6; color: #333;">
            This project is a result from the ProPENs Seminar supervised by the chair of Renewable and Sustainable Energy Systems of the TUM School of Engineering and Design in Garching. 
            The aim of the project was to provide an analysis of different site locations for DAC technology in Germany. For this 14 students came together and worked throughout the summer semester of 2025 on developing an interactive analysis tool based on own metrics and publicly available data mostly from official government sites. 
            </p>
        </div>

        <!-- Rechte Spalte: Bild -->
        <div style="flex: 1 1 300px;">
            <img src="img/garching.jpg" alt="DAC Facility Example" style="width: 100%; border-radius: 8px;" />
        </div>
    </div>
</section>
